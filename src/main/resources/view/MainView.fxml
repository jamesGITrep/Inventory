<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <VBox spacing="5.0" style="-fx-background-color: white; -fx-padding: 20;">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Wine Store Inventory System" />
                        <Label style="-fx-text-fill: #94a3b8;" text="Master (Excise Friendly)" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleExportCSV" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-background-radius: 5;" text="📥 Export CSV" />
               </children>
            </HBox>
            <HBox spacing="30.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5; -fx-padding: 8 15;" text="Inventory Management" />
                  <Button style="-fx-background-color: transparent; -fx-text-fill: #64748b;" text="Sales Reports &amp; Analytics" />
                  <Button style="-fx-background-color: transparent; -fx-text-fill: #64748b;" text="Transaction History" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
         </padding>
         <children>
            <HBox spacing="20.0">
               <children>
                  <VBox fx:id="cardTotalProducts" onMouseClicked="#handleTotalProductsClick" prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-cursor: hand;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8;" text="Total Products" />
                        <Label style="-fx-font-size: 28; -fx-font-weight: bold;" text="4" />
                     </children>
                  </VBox>
                  
                  <VBox fx:id="cardLowStock" onMouseClicked="#handleLowStockAlertClick" prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5); -fx-cursor: hand;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8;" text="Low Stock Alerts" />
                        <Label fx:id="lblLowStockCount" style="-fx-font-size: 28; -fx-font-weight: bold;" text="1" />
                     </children>
                  </VBox>
                  
                  <VBox prefWidth="280.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-text-fill: #94a3b8;" text="Total Profit" />
                        <Label fx:id="lblTotalProfit" style="-fx-font-size: 28; -fx-font-weight: bold;" text="₹72.50" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
               <children>
                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" text="SEARCH PRODUCTS" />
                           <TextField fx:id="searchField" promptText="Search by item name..." style="-fx-background-radius: 5; -fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                        </VBox>
                        <HBox alignment="BOTTOM_CENTER" spacing="10.0">
                           <Button onAction="#handleAddItem" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="+ Add Item" />
                           <Button onAction="#handleRecordPurchase" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="Record Purchase" />
                           <Button fx:id="btnSale" onAction="#handleBatchSalesEntry" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20;" text="Record Sale" />
                        </HBox>
                     </children>
                  </HBox>

                  <TableView fx:id="inventoryTable" prefHeight="400.0" style="-fx-background-color: transparent;">
                    <columns>
                      <TableColumn fx:id="colId" text="ITEM ID" />
                      <TableColumn fx:id="colName" prefWidth="180.0" text="WINE NAME" />
                      <TableColumn fx:id="colCategory" text="CATEGORY" />
                      <TableColumn fx:id="colSize" text="SIZE (ml)" /> 
                      <TableColumn fx:id="colOpeningStock" text="OPENING STOCK" />
                      <TableColumn fx:id="colPurchases" text="PURCHASES" />
                      <TableColumn fx:id="colSales" text="SALES" />
                      <TableColumn fx:id="colStock" text="CLOSING STOCK" />
                      <TableColumn fx:id="colPurchasePrice" text="PURCHASE PRICE" />
                      <TableColumn fx:id="colSellingPrice" text="SELLING PRICE" />
                      <TableColumn fx:id="colStatus" text="STOCK ALERT" />
                    </columns>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>