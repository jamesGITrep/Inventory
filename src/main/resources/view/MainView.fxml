<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <VBox style="-fx-background-color: white; -fx-padding: 16 24 0 24; -fx-border-color: transparent transparent #e2e8f0 transparent; -fx-border-width: 0 0 1 0;">
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="2.0">
                     <children>
                        <Label style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Wine Store Inventory System" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Inventory, sales, and reporting" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnSettings" onAction="#handleOpenSettings"
                          style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-padding: 8 10; -fx-background-radius: 6; -fx-cursor: hand;"
                          text="⚙" />
                  <Region prefWidth="8.0" />
                  <Button onAction="#handleExportCSV"
                          style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"
                          text="Export CSV" />
               </children>
            </HBox>

            <HBox spacing="4.0" style="-fx-padding: 14 0 0 0;">
               <children>
                  <Button fx:id="btnNavInventory" onAction="#handleShowDashboard" text="Inventory Management"
                          style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 5 5 0 0; -fx-padding: 8 18; -fx-font-weight: bold; -fx-cursor: hand;" />
                  <Button fx:id="btnNavAnalytics" onAction="#handleOpenAnalytics" text="Sales Reports and Analytics"
                          style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-background-radius: 5 5 0 0; -fx-padding: 8 18; -fx-cursor: hand;" />
                  <Button fx:id="btnNavPurchaseHistory" onAction="#handleOpenPurchaseHistory" text="Purchase History"
                          style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-background-radius: 5 5 0 0; -fx-padding: 8 18; -fx-cursor: hand;" />
                  <Button fx:id="btnNavHistory" onAction="#handleOpenTransactionHistory" text="Sales History"
                          style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-background-radius: 5 5 0 0; -fx-padding: 8 18; -fx-cursor: hand;" />
               </children>
            </HBox>
         </children>
      </VBox>

      <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
         <children>
            <VBox fx:id="dashboardView" spacing="16.0">
               <padding>
                  <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
               </padding>
               <children>
                  <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 14 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-text-fill: #16a34a; -fx-font-weight: bold; -fx-font-size: 12;" text="LIVE" />
                              <Label fx:id="lblCurrentDate" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="" />
                           </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 10 0 0 0;">
                           <children>
                              <Button fx:id="btnDateToday" onAction="#handleDateToday" text="Today"
                                      style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 5 14; -fx-font-weight: bold; -fx-cursor: hand;" />
                              <Button fx:id="btnDateYesterday" onAction="#handleDateYesterday" text="Yesterday"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button fx:id="btnDate3" text="10 Mar"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button fx:id="btnDate4" text="9 Mar"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button fx:id="btnDate5" text="8 Mar"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button fx:id="btnDate6" text="7 Mar"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button onAction="#handlePickDate" text="Pick Date"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button onAction="#handleDatePrev" text="Prev"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                              <Button fx:id="btnNextDate" onAction="#handleDateNext" text="Next"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #94a3b8; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox fx:id="cardTotalProducts" onMouseClicked="#handleTotalProductsClick"
                              alignment="CENTER_LEFT" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Products" />
                              <Label fx:id="lblTotalProducts" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="" />
                           </children>
                        </VBox>

                        <VBox fx:id="cardTotalStock"
                              alignment="CENTER_LEFT" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Stock" />
                              <Label fx:id="lblTotalStock" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="" />
                           </children>
                        </VBox>

                        <VBox fx:id="cardLowStock" onMouseClicked="#handleLowStockAlertClick"
                              alignment="CENTER_LEFT" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3); -fx-cursor: hand;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblLowStockTitle" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Low Stock Alerts" />
                              <Label fx:id="lblLowStockCount" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="" />
                           </children>
                        </VBox>

                        <VBox fx:id="cardRecentSales"
                              alignment="CENTER_LEFT" spacing="6.0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Profit" />
                              <Label fx:id="lblRecentSalesEntries" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
                        VBox.vgrow="ALWAYS">
                     <children>
                        <HBox alignment="BOTTOM_CENTER" spacing="14.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" text="SEARCH PRODUCTS" />
                                    <TextField fx:id="searchField" promptText="Search by product name..."
                                               onKeyReleased="#handleSearch"
                                               style="-fx-background-radius: 6; -fx-padding: 9 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-font-size: 13;" />
                                 </children>
                              </VBox>

                              <VBox spacing="5.0">
                                 <children>
                                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" text="CATEGORY FILTER" />
                                    <ComboBox fx:id="categoryFilter" onAction="#handleSearch" prefWidth="180.0"
                                              style="-fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-background-color: white;" />
                                 </children>
                              </VBox>

                              <HBox alignment="BOTTOM_CENTER" spacing="8.0">
                                 <children>
                                    <Button onAction="#handleAddItem"
                                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Add Item" />
                                    <Button onAction="#handleRecordPurchase"
                                            style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Record Purchase" />
                                    <Button onAction="#handleBatchSalesEntry"
                                            style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 6; -fx-cursor: hand;"
                                            text="Record Sale" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>

                        <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                           <VBox.margin>
                              <Insets top="16.0" />
                           </VBox.margin>
                           <columns>
                              <TableColumn fx:id="colId" text="ITEM ID" prefWidth="60.0" />
                              <TableColumn fx:id="colName" text="PRODUCT NAME" prefWidth="180.0" />
                              <TableColumn fx:id="colSize" text="SIZE (ML)" prefWidth="80.0" />
                              <TableColumn fx:id="colCategory" text="CATEGORY" prefWidth="100.0" />
                              <TableColumn fx:id="colOpeningStock" text="OPENING STOCK" prefWidth="110.0" />
                              <TableColumn fx:id="colPurchases" text="PURCHASES" prefWidth="90.0" />
                              <TableColumn fx:id="colSales" text="SALES" prefWidth="80.0" />
                              <TableColumn fx:id="colStock" text="CLOSING STOCK" prefWidth="110.0" />
                              <TableColumn fx:id="colPurchasePrice" text="PURCHASE PRICE" prefWidth="110.0" />
                              <TableColumn fx:id="colSellingPrice" text="SELLING PRICE" prefWidth="110.0" />
                              <TableColumn fx:id="colProfit" text="PROFIT" prefWidth="90.0" />
                              <TableColumn fx:id="colStatus" text="STOCK ALERT" prefWidth="100.0" />
                              <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="90.0" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" style="-fx-padding: 12 0 0 0;">
                           <children>
                              <Label fx:id="lblRowCount" style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="" />
                              <Region HBox.hgrow="ALWAYS" />
                              <HBox alignment="CENTER" spacing="6.0">
                                 <children>
                                    <Button fx:id="btnPrevPage" onAction="#handlePrevPage" text="Previous"
                                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                                    <Label fx:id="lblPageInfo"
                                           style="-fx-background-color: #f1f5f9; -fx-background-radius: 6; -fx-padding: 5 14; -fx-text-fill: #475569; -fx-font-weight: bold;"
                                           text="" />
                                    <Button fx:id="btnNextPage" onAction="#handleNextPage" text="Next"
                                            style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-padding: 5 14; -fx-cursor: hand;" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</VBox>
