<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="800.0" prefWidth="1200.0" spacing="20.0" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20;">
         <children>
            <Label text="Wine Store Inventory System" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
            <Label text="Master (Excise Friendly)" style="-fx-text-fill: #94a3b8;" />
            <HBox spacing="30.0" style="-fx-padding: 10 0 0 0;">
               <children>
                  <Button style="-fx-background-color: transparent; -fx-text-fill: #64748b;" text="Inventory Management" />
                  <Button style="-fx-background-color: transparent; -fx-text-fill: #1e293b; -fx-border-color: transparent transparent #2563eb transparent; -fx-border-width: 0 0 2 0;" text="Sales Reports &amp; Analytics" />
                  <Button style="-fx-background-color: transparent; -fx-text-fill: #64748b;" text="Transaction History" />
               </children>
            </HBox>
         </children>
      </VBox>

      <VBox spacing="25.0">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
         </padding>
         <children>
            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 15;">
               <children>
                  <Label text="Select Report Type" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 16;" />
                  <HBox alignment="CENTER" spacing="100.0">
                     <children>
                        <Button style="-fx-background-color: transparent; -fx-text-fill: #94a3b8;" text="Daily Sales Summary" />
                        <Button style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-weight: bold;" text="Monthly Report" />
                        <Button style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-weight: bold;" text="Annual Report" />
                        <Button style="-fx-background-color: transparent; -fx-text-fill: #334155; -fx-font-weight: bold;" text="Product Analysis" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 15;">
               <children>
                  <Label text="Select Date" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 14;" />
                  <DatePicker fx:id="datePicker" prefWidth="150.0" promptText="03/11/2026" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Sales" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label text="₹0.00" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                        <Label text="0 transactions" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>

                  <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Quantity Sold" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label text="0" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                        <Label text="units" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>

                  <VBox prefWidth="350.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Profit" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="lblTotalProfit" text="₹0.00" style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                        <Label text="0% margin" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox alignment="CENTER" prefHeight="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
               <children>
                  <Label text="No sales recorded for this date" style="-fx-text-fill: #475569; -fx-font-size: 14;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>