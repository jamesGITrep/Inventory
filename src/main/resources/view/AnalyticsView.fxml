<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1200.0" spacing="20.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <VBox spacing="25.0">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
         </padding>
         <children>
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 16;" text="Select Report Type" />
                  <HBox alignment="CENTER_LEFT" spacing="0.0">
                     <children>
                        <Button fx:id="btnDailyReport" onAction="#handleDailyReport" prefWidth="250.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #2563eb; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Daily Sales Summary" />
                        <Separator orientation="VERTICAL" prefHeight="20.0" />
                        <Button fx:id="btnMonthlyReport" onAction="#handleMonthlyReport" prefWidth="250.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Monthly Report" />
                        <Separator orientation="VERTICAL" prefHeight="20.0" />
                        <Button fx:id="btnAnnualReport" onAction="#handleAnnualReport" prefWidth="250.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Annual Report" />
                        <Separator orientation="VERTICAL" prefHeight="20.0" />
                        <Button onAction="#handleProductAnalysis" prefWidth="250.0"
                                style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Product Analysis" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 15;">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 13;" text="Select Date" />
                  <DatePicker fx:id="analyticsDatePicker" onAction="#handleAnalyticsDateChange" prefHeight="38.0" prefWidth="180.0"
                              promptText="Select Date..."
                              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" />
               </children>
            </VBox>

            <VBox spacing="20.0">
               <children>
                  <HBox fx:id="analyticsDataState" spacing="20.0">
                     <children>
                        <VBox prefHeight="160.0" prefWidth="350.0" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 25;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Total Sales" />
                              <Label fx:id="lblAnalyticsTotalSalesAmt" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Rs.0.00" />
                              <Label fx:id="lblAnalyticsTxCount" style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="0 transaction(s)" />
                           </children>
                        </VBox>

                        <VBox prefHeight="160.0" prefWidth="350.0" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 25;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Total Quantity Sold" />
                              <Label fx:id="lblAnalyticsTotalQty" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="units" />
                           </children>
                        </VBox>

                        <VBox prefHeight="160.0" prefWidth="350.0" spacing="12.0"
                              style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 25;"
                              HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="Total Profit" />
                              <Label fx:id="lblAnalyticsProfit" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Rs.0.00" />
                              <Label fx:id="lblAnalyticsMargin" style="-fx-text-fill: #64748b; -fx-font-size: 13;" text="0.0% margin" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox fx:id="analyticsEmptyState" alignment="CENTER" prefHeight="80.0"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                     <children>
                        <Label style="-fx-text-fill: #1e293b; -fx-font-size: 16;" text="No sales recorded for this period" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
