<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="500.0" spacing="15.0" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <VBox spacing="5.0">
         <children>
            <Label text="Edit Item" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
            <Label text="Update product information" style="-fx-text-fill: #64748b;" />
         </children>
      </VBox>

      <Separator />

      <VBox spacing="8.0" style="-fx-background-color: #f0f7ff; -fx-border-color: #bae6fd; -fx-border-radius: 8; -fx-padding: 15;">
         <children>
            <Label fx:id="lblEditItemId" text="Item ID" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;" />
            <Label fx:id="lblEditCurrentStock" text="Current Stock" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;" />
         </children>
      </VBox>

      <VBox spacing="12.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Product Name *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                  <TextField fx:id="txtProductName"
                             style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Category *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                  <ComboBox fx:id="comboCategory" maxWidth="1.7976931348623157E308"
                            style="-fx-padding: 5; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Opening Stock *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="txtQuantity"
                                   style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Low Stock Threshold *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="txtLowStockThreshold"
                                   style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <HBox spacing="15.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Purchase Price *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="txtPurchasePrice" onKeyReleased="#handleProfitInputChange"
                                   style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Selling Price *" style="-fx-font-weight: bold; -fx-text-fill: #334155;" />
                        <TextField fx:id="txtSellingPrice" onKeyReleased="#handleProfitInputChange"
                                   style="-fx-padding: 10; -fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <TextField fx:id="txtProfitMarginDisplay" editable="false"
                       style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-text-fill: #334155;"
                       text="Margin per unit:" />
         </children>
      </VBox>

      <Separator />

      <VBox spacing="10.0">
         <children>
            <Label text="Transaction History (Read Only)" style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12;" />
            <HBox spacing="100.0">
               <children>
                  <Label fx:id="lblHistoryPurchases" text="Purchases: 0" style="-fx-font-weight: bold;" />
                  <Label fx:id="lblHistorySales" text="Sales: 0" style="-fx-font-weight: bold;" />
               </children>
            </HBox>
         </children>
      </VBox>

      <HBox spacing="15.0">
         <children>
            <Button maxWidth="1.7976931348623157E308" onAction="#handleCancelModal"
                    style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-padding: 10; -fx-font-weight: bold;"
                    text="Cancel" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" onAction="#handleUpdateProduct"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10;"
                    text="Save Changes" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>
   </children>
</VBox>
