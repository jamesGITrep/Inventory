<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1200.0" spacing="20.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <VBox spacing="20.0">
         <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
         </padding>
         <children>
            <VBox spacing="5.0" style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-padding: 15; -fx-background-radius: 8;">
               <children>
                  <Label text="Sales Transaction History" style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold;" />
                  <Label text="Review recorded sales, filter by product or date, and verify the inventory impact for each transaction."
                         style="-fx-text-fill: #1e40af; -fx-font-size: 12;" />
               </children>
            </VBox>

            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="350.0" spacing="8.0"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;"
                        HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Transactions" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="lblTotalTransactions" text="0"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                        <Label text="sale records" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>
                  <VBox prefWidth="350.0" spacing="8.0"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;"
                        HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Sales Amount" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="lblTotalSalesAmount" text="Rs.0.00"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                        <Label fx:id="lblTotalUnitsSold" text="0 units sold" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>
                  <VBox prefWidth="350.0" spacing="8.0"
                        style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;"
                        HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="Total Profit" style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                        <Label fx:id="lblHistoryTotalProfit" text="Rs.0.00"
                               style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #16a34a;" />
                        <Label text="from the filtered transactions" style="-fx-text-fill: #94a3b8; -fx-font-size: 11;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox spacing="10.0"
                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;">
               <children>
                  <Label text="Filter Transactions" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 16;" />
                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Search by Product" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                              <TextField fx:id="txHistorySearch" onKeyReleased="#handleHistoryFilter"
                                         promptText="Search product name..."
                                         style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-padding: 10;" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Filter by Date" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                              <DatePicker fx:id="dpHistoryDate" maxWidth="1.7976931348623157E308" onAction="#handleHistoryFilter"
                                          promptText="Select date"
                                          style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
                           </children>
                        </VBox>
                        <VBox alignment="BOTTOM_LEFT" spacing="5.0">
                           <children>
                              <Button onAction="#handleClearHistoryFilter" text="Clear Filters"
                                      style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 10 18; -fx-background-radius: 6; -fx-cursor: hand;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-padding: 20;"
                  VBox.vgrow="ALWAYS">
               <children>
                  <Label text="All Sale Transactions" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 16;" />
                  <Label text="Complete history of recorded sales." style="-fx-text-fill: #64748b; -fx-font-size: 12;" />
                  <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                     <VBox.margin>
                        <Insets top="12.0" />
                     </VBox.margin>
                     <columns>
                        <TableColumn fx:id="colHistorySaleId" text="Sale ID" prefWidth="70.0" />
                        <TableColumn fx:id="colHistoryDate" text="Date" prefWidth="110.0" />
                        <TableColumn fx:id="colHistoryProduct" text="Product Name" prefWidth="240.0" />
                        <TableColumn fx:id="colHistorySize" text="Size (ml)" prefWidth="90.0" />
                        <TableColumn fx:id="colHistoryQty" text="Qty Sold" prefWidth="90.0" />
                        <TableColumn fx:id="colHistoryPrice" text="Unit Price" prefWidth="120.0" />
                        <TableColumn fx:id="colHistoryTotal" text="Total" prefWidth="120.0" />
                        <TableColumn fx:id="colHistoryProfit" text="Profit" prefWidth="110.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>
