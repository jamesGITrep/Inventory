<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="1100.0" spacing="10.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.winestore.inventory_system.controller.MainController">
   <children>
      <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Point of Sale (Batch Sale Entry)" />

      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Product Search &amp; Selection" textFill="#555555" />
                  
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Search:" />
                        <TextField fx:id="posSearchField" promptText="Enter product name..." HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" text="Search" />
                     </children>
                  </HBox>

                  <TableView fx:id="posInventoryTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colPosName" prefWidth="150.0" text="Product Name" />
                      <TableColumn fx:id="colPosSize" prefWidth="75.0" text="Size (ML)" />
                      <TableColumn fx:id="colPosCategory" prefWidth="100.0" text="Category" />
                      <TableColumn fx:id="colPosStock" prefWidth="100.0" text="Current Stock" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <HBox alignment="CENTER_LEFT" spacing="15.0">
                     <children>
                        <Button onAction="#refreshTable" text="Refresh" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAddToBill" prefWidth="120.0" style="-fx-background-color: #eeeeee; -fx-border-color: #333333;" text="Add To Bill" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10;" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Transaction Entry" textFill="#555555" />
                  <Label alignment="CENTER" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-font-size: 16;" text="Current Sale / Bill" />

                  <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colCartProduct" prefWidth="150.0" text="Product Name" />
                      <TableColumn fx:id="colCartQty" prefWidth="75.0" text="Qty" />
                      <TableColumn fx:id="colCartPrice" prefWidth="100.0" text="Unit Price" />
                    </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>

                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button onAction="#handleConfirmBatchSale" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #008CBA; -fx-text-fill: white; -fx-font-weight: bold;" text="Confirm Sale / Checkout" />
                        <Button onAction="#handleRemoveFromBill" prefHeight="50.0" prefWidth="120.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Clear Cart" />
                     </children>
                  </HBox>

                  <VBox alignment="CENTER" style="-fx-border-color: #008CBA; -fx-background-color: #f9f9f9; -fx-padding: 15;">
                     <children>
                        <Label fx:id="lblBillTotal" style="-fx-font-size: 24;" text="Total Amount: ₹0.00" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>