<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1120.0" spacing="16.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <VBox spacing="4.0">
         <children>
            <Label style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Batch Sales Entry" />
            <Label fx:id="lblEntryDate" style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="Entry Date:" />
         </children>
      </VBox>

      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Available Products" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="posSearchField" onKeyReleased="#handleSearchPos" promptText="Search product name..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-radius: 6; -fx-padding: 9 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                        <Button onAction="#handleSearchPos" text="Search"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;" />
                     </children>
                  </HBox>
                  <TableView fx:id="salesItemsTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colSaleProductName" text="Product Name" prefWidth="200.0" />
                        <TableColumn fx:id="colSaleSize" text="Size (ml)" prefWidth="90.0" />
                        <TableColumn fx:id="colSaleCategory" text="Category" prefWidth="120.0" />
                        <TableColumn fx:id="colSaleCurrentStock" text="Current Stock" prefWidth="110.0" />
                        <TableColumn fx:id="colSalePrice" text="Selling Price" prefWidth="110.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtSaleQuantity" promptText="Qty"
                                   style="-fx-background-radius: 6; -fx-padding: 9 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                        <Button onAction="#refreshPosTable" text="Refresh"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleAddToBill" text="Add To Batch"
                                style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox spacing="12.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16;"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label text="Sales Batch" style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                  <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCartProduct" text="Product Name" prefWidth="200.0" />
                        <TableColumn fx:id="colCartQty" text="Qty" prefWidth="80.0" />
                        <TableColumn fx:id="colCartPrice" text="Line Total" prefWidth="120.0" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <Label fx:id="lblBillTotal" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Batch Total: Rs.0.00" />
                  <HBox alignment="CENTER" spacing="12.0">
                     <children>
                        <Button onAction="#handleConfirmBatchSale" text="Save Batch"
                                style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button onAction="#handleRemoveFromBill" text="Remove Selected / Clear"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 18; -fx-background-radius: 6; -fx-cursor: hand;" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
</VBox>
