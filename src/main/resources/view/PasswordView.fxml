<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" spacing="25.0" 
      style="-fx-background-color: #f8fafc; -fx-padding: 40; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-background-radius: 12; -fx-border-radius: 12;" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.winestore.inventory_system.controller.PasswordController">
   <children>
      <VBox alignment="CENTER" spacing="10.0">
         <children>
            <Label fx:id="lblTitle" text="Inventory System" textFill="#1e293b">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Label fx:id="lblStatus" text="Please enter your password to continue" textAlignment="CENTER" textFill="#64748b" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
      <VBox spacing="18.0">
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label text="PASSWORD" textFill="#94a3b8">
                     <font>
                        <Font name="System Bold" size="10.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtPassword" onAction="#handleSubmit" prefHeight="48.0" 
                                promptText="••••••••"
                                style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-background-color: white; -fx-font-size: 15; -fx-padding: 0 15;" />
               </children>
            </VBox>
            <VBox fx:id="vboxConfirm" spacing="6.0">
               <children>
                  <Label fx:id="lblConfirm" text="CONFIRM PASSWORD" textFill="#94a3b8">
                     <font>
                        <Font name="System Bold" size="10.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtConfirmPassword" onAction="#handleSubmit" prefHeight="48.0" 
                                promptText="••••••••"
                                style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-background-color: white; -fx-font-size: 15; -fx-padding: 0 15;" />
               </children>
            </VBox>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </VBox>
      <Button mnemonicParsing="false" onAction="#handleSubmit" prefHeight="50.0" prefWidth="Infinity" 
              style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 16;" 
              text="Unlock System">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </Button>
      <Label text="Authorized Personnel Only" textFill="#94a3b8">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
   </children>
</VBox>
