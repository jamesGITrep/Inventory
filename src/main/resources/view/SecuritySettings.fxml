<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="600.0" prefWidth="450.0" spacing="15.0"
      style="-fx-background-color: #f4f4f4;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.SecurityController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>
      <Label text="Manager Control Panel" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Separator prefWidth="200.0" />

      <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-background-radius: 5;">
         <children>
            <Label text="System Backup Vault" textFill="#c0392b">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label text="Creates an encrypted backup vault plus a readable SQL companion export." textFill="#7f8c8d" wrapText="true">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Button fx:id="btnSecureBackup" maxWidth="1.7976931348623157E308" onAction="#handleSecureBackup"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-cursor: hand;"
                    text="Generate Secure Backup Folder" />
            <Label fx:id="lblLastSecured" text="Last Secured: Loading..." textFill="#95a5a6">
               <font>
                  <Font name="System Italic" size="11.0" />
               </font>
            </Label>
         </children>
      </VBox>

      <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-background-radius: 5;">
         <children>
            <Label text="Business Reports (CSV)" textFill="#2980b9">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label text="Export a read-only inventory CSV for Excel." textFill="#7f8c8d">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Button fx:id="btnExportCSV" maxWidth="1.7976931348623157E308" onAction="#handleExportCSV"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-cursor: hand;"
                    text="Export Read-Only CSV" />
         </children>
      </VBox>

      <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 12; -fx-border-color: #dcdde1; -fx-border-radius: 5; -fx-background-radius: 5;">
         <children>
            <Label text="Update Manager Password" textFill="#27ae60">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <HBox spacing="10.0">
               <children>
                  <PasswordField fx:id="txtNewPassword" promptText="Enter New Password" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnUpdatePass" onAction="#handleUpdatePassword"
                          style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand;"
                          text="Update" />
               </children>
            </HBox>
         </children>
      </VBox>

      <Separator prefWidth="200.0" />

      <Button fx:id="btnRestore" onAction="#handleRestore" prefHeight="35.0" prefWidth="250.0"
              style="-fx-border-color: #7f8c8d; -fx-background-color: white; -fx-cursor: hand;"
              text="Restore System from Vault" />
   </children>
</VBox>
