<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.PurchaseHistoryController">
   <padding>
      <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0"
            style="-fx-background-color: #eff6ff; -fx-border-color: #bfdbfe; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 12 16;">
         <children>
            <Label style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 13;"
                   text="Purchase History and stock-in audit trail for recorded procurement entries." />
         </children>
      </HBox>

      <HBox spacing="16.0">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Purchases" />
                  <Label fx:id="lblTotalPurchases" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="0" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Expenditure" />
                  <Label fx:id="lblTotalExpenditure" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="Rs.0.00" />
               </children>
            </VBox>

            <VBox alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
                  HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total Units Added" />
                  <Label fx:id="lblTotalUnits" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0 bottles" />
               </children>
            </VBox>
         </children>
      </HBox>

      <VBox spacing="16.0"
            style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 3);"
            VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Filter Purchases" />
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Category:" />
                        <ComboBox fx:id="comboCategory" onAction="#handleFilters" prefWidth="150.0"
                                  style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: #64748b; -fx-font-weight: bold;" text="Date Range:" />
                        <DatePicker fx:id="dateStart" onAction="#handleFilters" prefWidth="130.0"
                                    style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                        <Label text="to" />
                        <DatePicker fx:id="dateEnd" onAction="#handleFilters" prefWidth="130.0"
                                    style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 6;" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtSearch" onKeyReleased="#handleFilters" prefWidth="220.0"
                             promptText="Search product name"
                             style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 8 15; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;" />
               </children>
            </HBox>

            <TableView fx:id="purchaseTable" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colPurchaseId" prefWidth="90.0" text="Purchase ID" />
                  <TableColumn fx:id="colProductId" prefWidth="90.0" text="Product ID" />
                  <TableColumn fx:id="colProductName" prefWidth="220.0" text="Product Name" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colManufacturer" prefWidth="150.0" text="Manufacturer" />
                  <TableColumn fx:id="colQty" prefWidth="110.0" text="Quantity Added" />
                  <TableColumn fx:id="colPrice" prefWidth="130.0" text="Purchase Price" />
                  <TableColumn fx:id="colTotal" prefWidth="130.0" text="Total Cost" />
                  <TableColumn fx:id="colDate" prefWidth="150.0" text="Purchase Date" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
   </children>
</VBox>
