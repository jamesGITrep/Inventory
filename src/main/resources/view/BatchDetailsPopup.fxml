<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    BatchDetailsPopup.fxml
    Controller : com.winestore.inventory_system.controller.BatchDetailsController
    Purpose    : Shows the full price-batch history for a single product,
                 including FIFO-relevant "Qty Remaining" per batch and a
                 colour-coded Active / Depleted status indicator.
-->
<VBox spacing="0"
      prefWidth="700.0"
      style="-fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.BatchDetailsController">

    <!-- ── Header bar ──────────────────────────────────────────────────────── -->
    <VBox style="-fx-background-color: #1e293b; -fx-padding: 20 24 16 24;" spacing="4">
        <Label text="Batch Price History"
               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label fx:id="lblProductName"
               text="Product"
               style="-fx-font-size: 13; -fx-text-fill: #94a3b8;"/>
    </VBox>

    <!-- ── Summary chips ───────────────────────────────────────────────────── -->
    <HBox spacing="16" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
        <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>
        <VBox alignment="CENTER" spacing="2">
            <Label text="BATCHES" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
            <Label fx:id="lblTotalBatches" text="–"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox alignment="CENTER" spacing="2">
            <Label text="TOTAL STOCK" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
            <Label fx:id="lblTotalStock" text="–"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        </VBox>
        <Separator orientation="VERTICAL"/>
        <VBox alignment="CENTER" spacing="2">
            <Label text="COST RANGE" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
            <Label fx:id="lblPriceRange" text="–"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- ── Batch history table ─────────────────────────────────────────────── -->
    <VBox VBox.vgrow="ALWAYS" style="-fx-padding: 16 24 0 24;" spacing="8">
        <Label text="Batch Records (oldest first)"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>

        <TableView fx:id="batchTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8;">
            <columns>
                <TableColumn fx:id="colBatchId"   text="#"               prefWidth="50.0"  style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDate"       text="Date Received"   prefWidth="165.0"/>
                <TableColumn fx:id="colBuyPrice"   text="Cost Price"      prefWidth="110.0" style="-fx-alignment: CENTER_RIGHT;"/>
                <TableColumn fx:id="colSellPrice"  text="Sell Price"      prefWidth="110.0" style="-fx-alignment: CENTER_RIGHT;"/>
                <TableColumn fx:id="colStock"      text="Qty Remaining"   prefWidth="110.0" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colStatus"     text="Status"          prefWidth="100.0" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- ── Footer ──────────────────────────────────────────────────────────── -->
    <HBox alignment="CENTER_RIGHT" spacing="12"
          style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;">
        <padding><Insets top="14" right="24" bottom="14" left="24"/></padding>
        <Label text="Stock is depleted in FIFO order (oldest batch first)."
               style="-fx-font-size: 11; -fx-text-fill: #94a3b8;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Close" onAction="#handleClose"
                style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-padding: 9 22; -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>
</VBox>