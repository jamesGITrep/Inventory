<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" spacing="15.0"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.winestore.inventory_system.controller.MainController">

   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <children>

      <!-- Header -->
      <VBox spacing="4.0">
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Add New Item" />
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="Enter details for a brand-new product" />
         </children>
      </VBox>

      <Separator />

      <!-- Item Name -->
      <VBox spacing="5.0">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Item Name *" />
            <TextField fx:id="txtProductName" promptText="e.g. Kingfisher Beer"
                       style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
         </children>
      </VBox>

      <!-- Category -->
      <VBox spacing="5.0">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Category *" />
            <TextField fx:id="txtCategory" promptText="e.g. Beer, IMFL, Wine"
                       style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
         </children>
      </VBox>

      <!-- Manufacturer -->
      <VBox spacing="5.0">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Manufacturer" />
            <TextField fx:id="txtManufacturer" promptText="e.g. United Breweries"
                       style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
         </children>
      </VBox>

      <!-- Size + Purchase Price side by side -->
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Size (ml)" />
                  <TextField fx:id="txtSize" promptText="e.g. 750"
                             style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Purchase Price (₹) *" />
                  <TextField fx:id="txtPurchasePrice" promptText="0.00"
                             style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Selling Price + Opening Stock side by side -->
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Selling Price (₹) *" />
                  <TextField fx:id="txtSellingPrice" promptText="0.00"
                             style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Opening Stock *" />
                  <TextField fx:id="txtQuantity" promptText="0"
                             style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Low Stock Threshold -->
      <VBox spacing="5.0">
         <children>
            <Label style="-fx-font-weight: bold; -fx-text-fill: #334155;" text="Low Stock Alert Threshold" />
            <TextField fx:id="txtLowStockThreshold" promptText="Default: 10"
                       style="-fx-padding: 10; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" />
         </children>
      </VBox>

      <!-- Buttons -->
      <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
         <children>
            <Button maxWidth="1.7976931348623157E308" onAction="#handleCancelModal"
                    style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Cancel" HBox.hgrow="ALWAYS" />
            <Button maxWidth="1.7976931348623157E308" onAction="#handleSaveNewItem"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-border-radius: 5; -fx-padding: 10; -fx-font-weight: bold; -fx-cursor: hand;"
                    text="Save Item" HBox.hgrow="ALWAYS" />
         </children>
      </HBox>

   </children>
</VBox>