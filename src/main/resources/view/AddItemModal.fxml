<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane hgap="15.0" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" vgap="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.winestore.inventory_system.controller.MainController">
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
  </rowConstraints>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label text="Item Name" />
      <TextField fx:id="txtProductName" GridPane.columnIndex="1" />
      
      <Label text="Category" GridPane.rowIndex="1" />
      <ComboBox fx:id="comboCategory" editable="true" prefWidth="150.0" promptText="Select or Type..." GridPane.columnIndex="1" GridPane.rowIndex="1" />
      
      <Label text="Manufacturer" GridPane.rowIndex="2" />
      <ComboBox fx:id="comboManufacturer" editable="true" prefWidth="150.0" promptText="Select or Type..." GridPane.columnIndex="1" GridPane.rowIndex="2" />
      
      <Label text="Purchase Price" GridPane.rowIndex="3" />
      <TextField fx:id="txtPurchasePrice" GridPane.columnIndex="1" GridPane.rowIndex="3" />
      
      <Label text="Selling Price" GridPane.rowIndex="4" />
      <TextField fx:id="txtSellingPrice" GridPane.columnIndex="1" GridPane.rowIndex="4" />
      
      <Label text="Size (ml)" GridPane.rowIndex="5" />
      <TextField fx:id="txtSize" GridPane.columnIndex="1" GridPane.rowIndex="5" />
      
      <Label text="Opening Stock" GridPane.rowIndex="6" />
      <TextField fx:id="txtQuantity" GridPane.columnIndex="1" GridPane.rowIndex="6" />
      
      <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="7">
         <children>
            <Button onAction="#handleSaveNewItem" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Save Item" />
            <Button onAction="#handleCancelModal" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15;" text="Cancel" />
         </children>
      </HBox>
   </children>
</GridPane>